  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "loader",
    "spinner",
    "loading",
    "overlay"
  ],
  "author": "LNT Softwares",
  "license": "MIT"
}

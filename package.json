{
  "name": "@ssofton/loader",
  "version": "1.0.0",
  "description": "Lightweight JavaScript loading indicator",
  "type": "module",
  "main": "./dist/loader.umd.js",
  "module": "./dist/loader.esm.js",
  "browser": "./dist/loader.min.js",
  "exports": {
    ".": {
      "import": "./dist/loader.esm.js",
      "default": "./dist/loader.umd.js"
    }
